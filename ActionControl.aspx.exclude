<%@ Page Title="Action Control" Language="VB" AutoEventWireup="false" CodeBehind="ActionControl.aspx.vb" Inherits="ActionControlDemo.ActionControl" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Action Control</title>
    <style type="text/css">
        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #d9d9d9;
            margin: 0;
            padding: 20px;
        }

        .action-panel {
            max-width: 720px;
            margin: 0 auto;
            background-color: #eeeeee;
            box-shadow: 0 0 6px rgba(0,0,0,0.25);
        }

        .action-header {
            background-color: #3366ff;
            color: #ffffff;
            font-size: 26px;
            font-weight: bold;
            padding: 18px 24px;
        }

        .action-body {
            background-color: #ffffff;
            margin: 12px;
            padding: 20px 24px 30px 24px;
        }

        .form-row {
            display: table;
            width: 100%;
            margin-bottom: 14px;
        }

        .form-label {
            display: table-cell;
            width: 160px;
            vertical-align: middle;
            font-size: 14px;
            color: #222222;
            padding-right: 10px;
        }

        .form-control-cell {
            display: table-cell;
            vertical-align: middle;
        }

        .txt-input,
        .ddl-input {
            width: 380px;
            max-width: 100%;
            padding: 6px 8px;
            border: 1px solid #cccccc;
            border-radius: 3px;
            font-size: 14px;
        }

        .txt-input::placeholder {
            color: #bbbbbb;
        }

        .radio-inline label,
        .checkbox-inline label {
            margin-right: 18px;
            font-size: 14px;
            color: #222222;
        }

        .radio-inline input,
        .checkbox-inline input {
            margin-right: 4px;
            vertical-align: middle;
        }

        .receive-params-bar {
            background-color: #cfe0f7;
            padding: 8px 10px;
            border-radius: 2px;
            display: table;
            width: 100%;
        }

        .receive-params-bar label {
            margin-right: 18px;
            font-size: 14px;
        }

        .select-users-row {
            margin-top: 6px;
            font-size: 13px;
            color: #333333;
        }

        .script-box {
            width: 100%;
            max-width: 540px;
            height: 130px;
            border: 1px solid #cccccc;
            border-radius: 3px;
            padding: 8px;
            font-family: Consolas, monospace;
            font-size: 13px;
            resize: vertical;
        }

        .section-spacer {
            height: 18px;
        }

        .btn-row {
            text-align: right;
            margin-top: 20px;
        }

        .btn-save {
            background-color: #3366ff;
            color: #ffffff;
            border: none;
            padding: 8px 22px;
            border-radius: 3px;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-cancel {
            background-color: #cccccc;
            color: #222222;
            border: none;
            padding: 8px 22px;
            border-radius: 3px;
            font-size: 14px;
            cursor: pointer;
            margin-left: 8px;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div class="action-panel">
            <div class="action-header">Action Control</div>

            <div class="action-body">

                <%-- Action Status --%>
                <div class="form-row">
                    <div class="form-label">Action Status</div>
                    <div class="form-control-cell">
                        <asp:RadioButtonList ID="rblActionStatus" runat="server" RepeatDirection="Horizontal" CssClass="radio-inline">
                            <asp:ListItem Text="Active" Value="Active" Selected="True" />
                            <asp:ListItem Text="InActive" Value="InActive" />
                        </asp:RadioButtonList>
                    </div>
                </div>

                <%-- Action Title --%>
                <div class="form-row">
                    <div class="form-label">Action Title</div>
                    <div class="form-control-cell">
                        <asp:TextBox ID="txtActionTitle" runat="server" CssClass="txt-input" placeholder="Action Title" />
                    </div>
                </div>

                <%-- Action Type --%>
                <div class="form-row">
                    <div class="form-label">Action Type</div>
                    <div class="form-control-cell">
                        <asp:DropDownList ID="ddlActionType" runat="server" CssClass="ddl-input">
                            <asp:ListItem Value="MOVE" >Move To Next State</asp:ListItem>
                            <asp:ListItem Value="DLET" >Delete</asp:ListItem>
                            <asp:ListItem Value="ACTV" >Activate</asp:ListItem>
                            <asp:ListItem Value="DACTV" >De-Activate</asp:ListItem>
                            <asp:ListItem >Edit</asp:ListItem>
                        </asp:DropDownList>
                    </div>
                </div>

                <%-- Implementer Title --%>
                <div class="form-row">
                    <div class="form-label">Implementer Title</div>
                    <div class="form-control-cell">
                        <asp:TextBox ID="txtImplementerTitle" runat="server" CssClass="txt-input" placeholder="Maker, Checker, etc" />
                    </div>
                </div>

                <%-- Show In --%>
                <div class="form-row">
                    <div class="form-label">Show in</div>
                    <div class="form-control-cell">
                        <asp:CheckBoxList ID="cblShowIn" runat="server" RepeatDirection="Vertical" CssClass="checkbox-inline">
                            <asp:ListItem Text="Show In Default" Value="Default" Selected="True" />
                            <asp:ListItem Text="Show In Preview" Value="Preview" />
                        </asp:CheckBoxList>
                    </div>
                </div>

                <%-- Receive Parameters --%>
                <div class="form-row">
                    <div class="form-label">
                        Receive Parameters
                        <asp:CheckBox ID="chkReceiveParameters" runat="server" />
                    </div>
                    <div class="form-control-cell">
                        <div class="receive-params-bar">
                            <asp:RadioButtonList ID="rblReceiveParameters" runat="server" RepeatDirection="Horizontal">
                                <asp:ListItem Text="No" Value="No" Selected="True" />
                                <asp:ListItem Text="For Enable" Value="ForEnable" />
                                <asp:ListItem Text="For Disable" Value="ForDisable" />
                                <asp:ListItem Text="To Hide" Value="ToHide" />
                            </asp:RadioButtonList>
                        </div>
                        <div class="select-users-row">
                            <asp:LinkButton ID="lnkSelectUsers" runat="server" Text="Select Users" />
                        </div>
                    </div>
                </div>

                <div class="section-spacer"></div>

                <%-- Script --%>
                <div class="form-row">
                    <div class="form-label">Script</div>
                    <div class="form-control-cell">
                        <asp:TextBox ID="txtScript" runat="server" TextMode="MultiLine" CssClass="script-box" />
                    </div>
                </div>

                <div class="section-spacer"></div>

                <%-- Pre-Execution --%>
                <div class="form-row">
                    <div class="form-label">Pre-Execution</div>
                    <div class="form-control-cell">
                        <asp:RadioButtonList ID="rblPreExecution" runat="server" RepeatDirection="Horizontal" CssClass="radio-inline">
                            <asp:ListItem Text="None" Value="None" Selected="True" />
                            <asp:ListItem Text="Confirmation" Value="Confirmation" />
                            <asp:ListItem Text="Parameter" Value="Parameter" />
                        </asp:RadioButtonList>
                    </div>
                </div>

                <div class="btn-row">
                    <asp:Button ID="btnSave" runat="server" Text="Save" CssClass="btn-save" OnClick="btnSave_Click" />
                    <asp:Button ID="btnCancel" runat="server" Text="Cancel" CssClass="btn-cancel" CausesValidation="false" OnClick="btnCancel_Click" />
                </div>

                <asp:Label ID="lblMessage" runat="server" ForeColor="Green" Font-Bold="true" />

            </div>
        </div>
    </form>
</body>
</html>
